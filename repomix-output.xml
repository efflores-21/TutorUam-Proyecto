package com.example.tutoruam_proyecto.ui.service

object TokenManager {
    private var token: String? = null
    private var name: String? = null
    private var email: String? = null

    fun saveUser(token: String?, name: String?, email: String?) {
        this.token = token
        this.name = name
        this.email = email
    }

    fun getToken(): String? = token
    fun getName(): String = name ?: "Usuario"
    fun getEmail(): String = email ?: "usuario@uam.edu.ni"

    fun clear() {
        token = null
        name = null
        email = null
    }
}
